# Copy ONLY onto the VPS as /opt/ecommerce-gpay/shared/production.env, chmod 600.
# Replace every CHANGE_ME. Use public IPv4 from your VPS, not the VMware/LAN address.
DOMAIN=shop-CHANGE_ME_PUBLIC_IP_WITH_DASHES.sslip.io
ACME_EMAIL=CHANGE_ME_EMAIL
DB_ROOT_PASSWORD=CHANGE_ME_RANDOM_HEX_64
DB_APP_PASSWORD=CHANGE_ME_DIFFERENT_RANDOM_HEX_64
APP_JWT_SECRET=CHANGE_ME_RANDOM_HEX_128
# Keep empty until YOUR account is registered. Set it, restart backend once, then clear it.
APP_ADMIN_EMAIL=
# Public web can be tested with payments disabled. Enabling real payments requires G-Pay approval/testing.
APP_PAYMENTS_ENABLED=false
GPAY_API_BASE_URL=https://openapi-sandbox.g-pay.vn/v1
GPAY_CLIENT_ID=disabled
GPAY_MERCHANT_CODE=disabled
GPAY_MERCHANT_ID=disabled
GPAY_CLIENT_SECRET=disabled
GPAY_PRIVATE_KEY=disabled
GPAY_CERTIFICATE=disabled
